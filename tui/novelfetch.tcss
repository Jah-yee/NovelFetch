/* CustomHeader styles are now in shared.py DEFAULT_CSS */

Screen {
    background: $surface;
    layout: vertical;
}
.title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 0 1;
}
.banner {
    text-align: center;
    color: $accent;
    padding: 2 0 0 0;
}
.section-header {
    text-style: bold;
    color: $text-muted;
    padding: 1 0 0 0;
    text-align: center;
}
.section-group {
    height: auto;
}
/* Beacon rules: register focus-within on the group itself so Textual
   refreshes the subtree on focus change (final selector must match node) */
#primary-group:focus-within {
    height: auto;
}
#browse-group:focus-within {
    height: auto;
}
#primary-group:focus-within > .section-header,
#browse-group:focus-within > .section-header {
    color: $accent;
    text-style: bold underline;
}
ListView {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
}
ListView:focus {
    border: none;
}
ListView > ListItem {
    padding: 0 1;
    background: transparent;
}
ListView > ListItem > Label {
    padding: 0;
}
ListView > ListItem.-highlight,
ListView:focus > ListItem.-highlight {
    background: transparent;
    color: $accent;
    text-style: bold;
}
ListView > ListItem.-highlight > Label,
ListView:focus > ListItem.-highlight > Label {
    color: $accent;
    text-style: bold;
}

ListView {
    margin: 0 1;
}
ListItem {
    padding: 0 1;
}
.loading {
    display: none;
    height: 3;
    content-align: center middle;
}
.loading.-visible {
    display: block;
}
#dl-bar {
    margin: 1 2;
}
#dl-status {
    margin: 0 2;
    text-style: italic;
    color: $text-muted;
}
#dl-novel {
    text-align: center;
    color: $text-muted;
    padding: 0 1;
}
.dialog-overlay {
    align: center middle;
}
.dialog-box {
    width: 40%;
    height: auto;
    min-height: 6;
    border: thick $accent;
    background: $surface;
    padding: 0 1;
}
Input {
    margin: 0 1;
}
#page-info {
    padding: 0 1;
    text-style: italic;
    color: $text-muted;
}
/* Main menu: center items under PRIMARY ACTIONS / BROWSE */
#primary-actions > ListItem > Label,
#browse-actions > ListItem > Label {
    width: 1fr;
    text-align: center;
}
#main-content {
    height: 1fr;
    width: 100%;
    layout: vertical;
}